# ============================================================================
#  Copiá este archivo como `.env` y pegá tus valores.
#
#  Windows (PowerShell):   copy .env.example .env
#  macOS / Linux:          cp .env.example .env
#
#  Las dos claves están en: Supabase Dashboard → Project Settings → API
#  Después de editarlo, reiniciá SIEMPRE con:  npx expo start -c
#  (la -c limpia la cache, sin eso los cambios no se ven)
# ============================================================================

# Debe terminar en .supabase.co — no es la URL del sitio web,
# es la URL de la API.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# La "anon public" key. Empieza con "eyJ".
# Es pública por diseño: va en la app sin miedo.
# NUNCA pongas acá la "service_role": esa sí es secreta.
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx
